# Bu dosyayı .env olarak kopyalayın. .env dosyası ASLA depoya eklenmez.

# --- Temel ---
DJANGO_DEBUG=1
# Üretimde zorunlu; üretmek için: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Yönetim paneli adresi; tahmin edilmesi zor bir şey seçin
DJANGO_ADMIN_URL=yonetim-kapisi/

# --- docker-compose için alan adı (Caddy otomatik HTTPS sertifikası alır) ---
KANAT_DOMAIN=

# --- Gizli dosyalar (sponsorluk PDF'leri) — web sunucusu bu klasörü SUNMAMALI ---
DJANGO_PRIVATE_MEDIA_ROOT=

# --- Ters vekil (nginx/Caddy) arkasında ---
DJANGO_BEHIND_PROXY=0
DJANGO_TRUST_X_FORWARDED_FOR=0

# --- Veritabanı (boşsa SQLite) ---
POSTGRES_DB=
POSTGRES_USER=kanat
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# --- Hız sınırlama için (birden çok işlemde önerilir; yoksa üretimde veritabanı önbelleği kullanılır) ---
REDIS_URL=

# --- Güvenlik ---
# Yönetim paneli için iki adımlı doğrulama (üretimde varsayılan 1)
KANAT_ADMIN_REQUIRE_2FA=1

# --- Hata izleme (isteğe bağlı) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=uretim

# --- KVKK saklama süreleri (gün) ---
KANAT_RETENTION_AUDIT_DAYS=730
KANAT_RETENTION_NOTIFICATION_DAYS=90

# --- E-posta (boşsa e-postalar konsola yazılır) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Kanat <no-reply@ornek.com>

# --- Site ve KVKK veri sorumlusu bilgileri ---
KANAT_SITE_NAME=Kanat
KANAT_SITE_TAGLINE=Geleceğin Yönünü Değiştiren Hayatlar
KANAT_SITE_URL=http://localhost:8000
KANAT_DATA_CONTROLLER_NAME=
KANAT_DATA_CONTROLLER_ADDRESS=
KANAT_DATA_CONTROLLER_EMAIL=
KANAT_DATA_CONTROLLER_KEP=
KANAT_SECURITY_CONTACT=
# Hukuki metinler bir hukukçu tarafından incelendikten sonra 0 yapın
KANAT_LEGAL_DRAFT_NOTICE=1
